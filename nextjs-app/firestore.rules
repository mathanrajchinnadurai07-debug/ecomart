rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only backend can write. Clients can only read.
    
    // Anyone can read products
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Server-side writes only
    }

    // Users can only read their own orders
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false; // Server-side writes only
    }

    // Users can read and write their own profile and subcollections (cart, sessions)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to subcollections like 'cart', 'active_sessions', etc.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
